# ==========================================
# Booking API — Environment Configuration
# ==========================================

PORT=8080
HOST=0.0.0.0

# ------------------------------------------------------------------
# SUPABASE — Asymmetric JWT Verification via JWKS (ES256 / P-256)
# ------------------------------------------------------------------
# The backend verifies Supabase-issued JWTs using the public keys
# served at: <SUPABASE_URL>/auth/v1/.well-known/jwks.json
#
# No secret key is needed. The signing algorithm is ES256 (ECC P-256).
SUPABASE_URL=https://your-project-id.supabase.co
